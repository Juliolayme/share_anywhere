root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

# Android (ktlint, android_studio code style; android/app/build.gradle.kts runs ktlintCheck).
[*.{kt,kts}]
indent_size = 4
max_line_length = 140
ktlint_code_style = android_studio
# Compose: @Composable functions are PascalCase nouns.
ktlint_function_naming_ignore_when_annotated_with = Composable
