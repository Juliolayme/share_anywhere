# Copy to .env for local development. Never commit real secrets.

# Backend
SA_ENV=development                 # development | test | production
SA_HTTP_ADDR=:8080
SA_LOG_LEVEL=info                  # debug | info | warn | error
SA_SHUTDOWN_TIMEOUT=10s
SA_ALLOWED_ORIGINS=https://localhost:8443
DATABASE_URL=postgres://shareanywhere:devpassword@localhost:5432/shareanywhere?sslmode=disable

# Docker Compose
POSTGRES_PASSWORD=devpassword
TURN_SHARED_SECRET=dev-turn-secret-change-me   # coturn use-auth-secret; must match the backend from Phase 2

# Backend tests against a real database (optional locally, set in CI)
TEST_DATABASE_URL=postgres://shareanywhere:devpassword@localhost:5432/shareanywhere?sslmode=disable
