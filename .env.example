# Copy to .env for local development. Never commit real secrets.

# Backend
SA_ENV=development                 # development | test | production
SA_HTTP_ADDR=:8080
SA_LOG_LEVEL=info                  # debug | info | warn | error
SA_SHUTDOWN_TIMEOUT=10s
SA_ALLOWED_ORIGINS=https://localhost:8443
DATABASE_URL=postgres://shareanywhere:devpassword@localhost:5432/shareanywhere?sslmode=disable
SA_MIGRATE_ON_START=true           # apply goose migrations at startup (ADR 0007)
SA_TRUSTED_PROXIES=                # CIDRs whose X-Forwarded-For is believed, e.g. 172.16.0.0/12 behind Caddy
SA_COOKIE_SECURE=true              # Secure attribute on the sa_device refresh cookie; false is rejected in production
SA_POW_DIFFICULTY=16               # leading zero bits for the device-creation proof-of-work (8-28)
# Device token signing keys (ADR 0008). Required in production; development and test generate ephemeral
# values when empty, so tokens stop working after a restart. Generate a key with:
#   node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
SA_TOKEN_KEYS=                     # comma-separated kid:base64(32-byte Ed25519 seed); keep old kids while their tokens live
SA_TOKEN_ACTIVE_KID=               # kid that signs new tokens
SA_SERVER_SECRET=                  # base64 of >= 32 random bytes; keys proof-of-work and other HMACs
SA_RATE_LIMIT_MULTIPLIER=1         # test stacks only (SA_ENV=test); scales every rate limit
SA_PUBLIC_URL=https://localhost:8443  # Web origin used in join links and QR codes (default: first allowed origin)
SA_ANDROID_CERT_SHA256=  # Android App Links: SHA-256 fingerprint of the app signing certificate (AA:BB:…); empty = no assetlinks.json
SA_APPLE_APP_ID=  # iOS Universal Links: <Team ID>.app.shareanywhere; empty = no apple-app-site-association
SA_TURN_SECRET=dev-turn-secret-change-me  # coturn static-auth-secret; required in production (>= 16 chars)
SA_TURN_URIS=turn:127.0.0.1:3478?transport=udp,turn:127.0.0.1:3478?transport=tcp  # an IPv4 literal locally: `localhost` can resolve to ::1, which coturn does not answer (ice-error 701)
SA_CODE_GUESS_ALARM_PER_MIN=300    # failed code lookups per minute that turn on protected mode
SA_METRICS_ADDR=                   # internal Prometheus listener, e.g. :9090 (GET /metrics); empty disables; never expose publicly
SA_TURN_METRICS_URL=               # coturn Prometheus exporter for the relay byte cap per session; empty disables the cap
SA_GUEST_RELAY_BYTES_CAP=25000000000    # relay bytes per session with a guest sender before credentials stop renewing
SA_ACCOUNT_RELAY_BYTES_CAP=100000000000 # the same with a signed-in sender
# Cloud Distribution (Phase 8, docs/ADR/0030-cloud-distribution.md): off unless true. docker compose --profile cloud
# starts an S3-compatible gateway at http://s3:7070 whose root keys are SA_S3_ACCESS_KEY / SA_S3_SECRET_KEY.
SA_CLOUD_ENABLED=false
SA_CLOUD_STORE=s3                  # s3 | memory (development/test only; objects lost on restart)
SA_S3_ENDPOINT=http://s3:7070
SA_S3_REGION=us-east-1
SA_S3_BUCKET=share-anywhere-cloud
SA_S3_ACCESS_KEY=                  # never commit real keys
SA_S3_SECRET_KEY=
SA_CLOUD_TTL=24h                   # longest an object is kept (1m..720h); deleted earlier once every receiver has it
SA_CLOUD_DEFAULT_BUDGET_BYTES=10737418240   # monthly budget (bytes uploaded + downloaded) until the account sets one
SA_CLOUD_MAX_BUDGET_BYTES=1099511627776
SA_CLOUD_PRICE_STORAGE_GB_MONTH=   # prices are configuration, never hard-coded; empty = "cost unknown" in estimates
SA_CLOUD_PRICE_EGRESS_GB=
SA_CLOUD_CURRENCY=USD
# Password-reset mail (Phase 5A). console: logs the reset link only with SA_ENV=development (never the address);
# smtp: deliver through SA_SMTP_ADDR (docker compose --profile mail up starts mailpit at mailpit:1025, UI on
# http://localhost:8025); memory: SA_ENV=test only, read back via GET /v1/_test/mail/last in testhooks builds.
SA_MAIL_SINK=console               # console | smtp | memory
SA_SMTP_ADDR=                      # host:port, required with smtp, e.g. mailpit:1025
SA_SMTP_USERNAME=                  # optional; credentials are sent only over TLS (STARTTLS) or to localhost
SA_SMTP_PASSWORD=                  # optional; never commit a real one
SA_MAIL_FROM=Share Anywhere <no-reply@localhost>

# Web build-time settings (read by Vite; CLAUDE.md §8b). Flags turn on only in the phase that makes them work.
VITE_FLAG_SHARING=true             # on since Phase 2 (create and join share sessions); false builds without it
VITE_FLAG_ACCOUNTS=true            # on since Phase 5A (sign in, account Devices list, history sync); false builds without it
VITE_FLAG_CLIPBOARD=true           # on since Phase 5B (Clipboard Sync: text only, end-to-end encrypted); false builds without it
VITE_APP_VERSION=0.1.0             # shown in Settings
VITE_BLOCK_CACHE_MB=64             # sender block cache shared by receivers (MiB, at least one 4 MiB block)
VITE_TEST_HOOKS=false              # test stacks only (docker-compose.ci.yml): engine counters and fault injection; never in production

# Android build-time settings are Gradle properties, not environment variables (README "Android app"):
#   -Pbackend=http://10.0.2.2:8080        debug backend (default: the host as the emulator sees it)
#   -PreleaseBackend=https://example.org  required for release builds, HTTPS only

# Docker Compose
POSTGRES_PASSWORD=devpassword
TURN_SHARED_SECRET=dev-turn-secret-change-me   # coturn use-auth-secret; must match the backend from Phase 2

# Backend tests against a real database (optional locally, set in CI)
TEST_DATABASE_URL=postgres://shareanywhere:devpassword@localhost:5432/shareanywhere?sslmode=disable
