<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device through backup or device-to-device transfer: the refresh secret is bound to this
     installation's Keystore key, and local history stays on this device (PRD §2 History, docs/SECURITY_MODEL.md §4). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
