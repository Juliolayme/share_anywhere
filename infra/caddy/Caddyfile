# Edge proxy for local development: HTTPS with Caddy's internal CA on https://localhost:8443.
{
	auto_https disable_redirects
	admin off
}

https://localhost:8443 {
	tls internal
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Android App Links (RX-3): the app's signing-certificate fingerprint from SA_ANDROID_CERT_SHA256
	# (docs/runbooks/android-app-links.md). Unset, the file is not served and links open in the browser.
	@assetlinks {
		path /.well-known/assetlinks.json
		expression {env.SA_ANDROID_CERT_SHA256} != ""
	}
	handle @assetlinks {
		header Content-Type application/json
		respond `[{"relation":["delegate_permission/common.handle_all_urls"],"target":{"namespace":"android_app","package_name":"app.shareanywhere","sha256_cert_fingerprints":["{$SA_ANDROID_CERT_SHA256}"]}}]` 200
	}

	@api path /v1/* /healthz /readyz
	handle @api {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy web:8080
	}
}
