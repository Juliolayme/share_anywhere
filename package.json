{
  "name": "share-anywhere",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22 <23"
  },
  "type": "module",
  "scripts": {
    "tokens": "node scripts/gen-tokens.mjs",
    "tokens:check": "node scripts/gen-tokens.mjs --check",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#**/node_modules\" \"#design\"",
    "brand": "node scripts/export-brand.mjs",
    "brand:check": "node scripts/export-brand.mjs --check",
    "i18n": "node scripts/gen-i18n.mjs",
    "i18n:check": "node scripts/gen-i18n.mjs --check",
    "protocol": "node scripts/protocol.mjs",
    "protocol:check": "node scripts/protocol.mjs --check",
    "storage:check": "node scripts/check-storage.mjs"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "ajv": "8.20.0",
    "json5": "2.2.3",
    "markdownlint-cli2": "0.24.0",
    "openapi-typescript": "7.13.0",
    "sharp": "0.35.5",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "overrides": {
      "re2js": "2.8.7",
      "katex": "0.18.2",
      "@typescript-eslint/typescript-estree>minimatch": "11.0.1"
    }
  }
}
