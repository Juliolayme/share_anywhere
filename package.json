{
  "name": "share-anywhere",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22 <23"
  },
  "type": "module",
  "scripts": {
    "tokens": "node scripts/gen-tokens.mjs",
    "tokens:check": "node scripts/gen-tokens.mjs --check",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#**/node_modules\" \"#design\""
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "markdownlint-cli2": "0.18.1"
  }
}
