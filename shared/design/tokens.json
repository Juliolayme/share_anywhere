{
  "$schema": "./tokens.schema.json",
  "$comment": "PROVISIONAL: values must be replaced with the tokens from design/claude-design/Design System.dc.html once the handoff is imported (CLAUDE.md, UI source of truth).",
  "version": 1,
  "brand": {
    "blue": "#0878E8",
    "green": "#16C75A",
    "navy": "#102A56",
    "white": "#FFFFFF"
  },
  "color": {
    "light": {
      "bg": "#F7FAFD",
      "surface": "#FFFFFF",
      "surface-raised": "#FFFFFF",
      "surface-muted": "#EEF3F9",
      "border": "#D6DFEA",
      "border-strong": "#7C8DA8",
      "text": "#102A56",
      "text-muted": "#4A5D7E",
      "text-inverse": "#FFFFFF",
      "primary": "#0668CC",
      "primary-hover": "#0557AB",
      "on-primary": "#FFFFFF",
      "primary-soft": "#E3F0FD",
      "on-primary-soft": "#064F9C",
      "receive": "#0B7A36",
      "receive-soft": "#E2F7EA",
      "on-receive-soft": "#0A6A2F",
      "success": "#0B7A36",
      "success-soft": "#E2F7EA",
      "warning": "#9A4A00",
      "warning-soft": "#FFF1DC",
      "error": "#C62828",
      "error-soft": "#FDE8E8",
      "info": "#0668CC",
      "info-soft": "#E3F0FD",
      "focus": "#0878E8",
      "overlay": "rgba(16, 42, 86, 0.48)"
    },
    "dark": {
      "bg": "#0B1730",
      "surface": "#102243",
      "surface-raised": "#152B52",
      "surface-muted": "#16305A",
      "border": "#24406E",
      "border-strong": "#5577AA",
      "text": "#E8EEF8",
      "text-muted": "#A9B8D3",
      "text-inverse": "#0B1730",
      "primary": "#3D97F0",
      "primary-hover": "#5AA9F4",
      "on-primary": "#06142B",
      "primary-soft": "#12335E",
      "on-primary-soft": "#B9DAFB",
      "receive": "#2FD672",
      "receive-soft": "#0E3A26",
      "on-receive-soft": "#A8F0C6",
      "success": "#34D27A",
      "success-soft": "#0E3A26",
      "warning": "#F5B04C",
      "warning-soft": "#3A2A0E",
      "error": "#FF7A7A",
      "error-soft": "#3D1518",
      "info": "#5AA9F4",
      "info-soft": "#12335E",
      "focus": "#5AA9F4",
      "overlay": "rgba(3, 8, 20, 0.64)"
    }
  },
  "contrast": {
    "AA": [
      [
        "text",
        "bg"
      ],
      [
        "text",
        "surface"
      ],
      [
        "text-muted",
        "bg"
      ],
      [
        "text-muted",
        "surface"
      ],
      [
        "on-primary",
        "primary"
      ],
      [
        "on-primary",
        "primary-hover"
      ],
      [
        "on-primary-soft",
        "primary-soft"
      ],
      [
        "on-receive-soft",
        "receive-soft"
      ],
      [
        "success",
        "surface"
      ],
      [
        "warning",
        "surface"
      ],
      [
        "error",
        "surface"
      ],
      [
        "info",
        "surface"
      ],
      [
        "receive",
        "surface"
      ]
    ],
    "nonText": [
      [
        "border-strong",
        "surface"
      ],
      [
        "focus",
        "surface"
      ]
    ]
  },
  "font": {
    "family": {
      "sans": "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Noto Sans\", \"Helvetica Neue\", Arial, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, \"Roboto Mono\", Menlo, Consolas, \"Liberation Mono\", monospace"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "size": {
      "xs": [
        "12px",
        "16px"
      ],
      "sm": [
        "14px",
        "20px"
      ],
      "base": [
        "16px",
        "24px"
      ],
      "lg": [
        "18px",
        "28px"
      ],
      "xl": [
        "20px",
        "28px"
      ],
      "2xl": [
        "24px",
        "32px"
      ],
      "3xl": [
        "30px",
        "36px"
      ],
      "4xl": [
        "36px",
        "44px"
      ],
      "code": [
        "40px",
        "48px"
      ]
    }
  },
  "space": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px"
  },
  "radius": {
    "none": "0px",
    "sm": "6px",
    "md": "10px",
    "lg": "14px",
    "xl": "20px",
    "full": "9999px"
  },
  "border": {
    "thin": "1px",
    "strong": "2px",
    "focus": "3px"
  },
  "elevation": {
    "light": {
      "0": "none",
      "1": "0 1px 2px rgba(16, 42, 86, 0.06), 0 1px 3px rgba(16, 42, 86, 0.08)",
      "2": "0 4px 12px rgba(16, 42, 86, 0.10)",
      "3": "0 12px 32px rgba(16, 42, 86, 0.14)"
    },
    "dark": {
      "0": "none",
      "1": "0 1px 2px rgba(0, 0, 0, 0.30)",
      "2": "0 4px 12px rgba(0, 0, 0, 0.36)",
      "3": "0 12px 32px rgba(0, 0, 0, 0.44)"
    }
  },
  "motion": {
    "duration": {
      "fast": "120ms",
      "base": "200ms",
      "slow": "320ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "exit": "cubic-bezier(0.3, 0, 1, 1)"
    }
  },
  "breakpoint": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px"
  },
  "touchTarget": {
    "web": "44px",
    "android": "48dp",
    "ios": "44pt"
  }
}
