{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Share Anywhere design tokens",
  "type": "object",
  "required": [
    "version",
    "brand",
    "logo",
    "color",
    "contrast",
    "font",
    "space",
    "radius",
    "border",
    "elevation",
    "control",
    "motion",
    "breakpoint",
    "touchTarget"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 2
    },
    "brand": {
      "type": "object",
      "required": [
        "blue",
        "green",
        "navy",
        "white"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/hex"
      }
    },
    "logo": {
      "type": "object",
      "required": [
        "geometry",
        "modes",
        "wordmark"
      ],
      "properties": {
        "modes": {
          "type": "object",
          "required": [
            "color",
            "dark",
            "mono-dark",
            "mono-light"
          ],
          "additionalProperties": {
            "type": "object",
            "required": [
              "send",
              "receive",
              "dot",
              "text"
            ],
            "additionalProperties": {
              "$ref": "#/$defs/hex"
            }
          }
        }
      }
    },
    "color": {
      "type": "object",
      "required": [
        "light",
        "dark"
      ],
      "additionalProperties": false,
      "properties": {
        "light": {
          "$ref": "#/$defs/palette"
        },
        "dark": {
          "$ref": "#/$defs/palette"
        }
      }
    },
    "contrast": {
      "type": "object",
      "required": [
        "AA",
        "AALarge",
        "nonText"
      ],
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "font": {
      "type": "object",
      "required": [
        "family",
        "weight",
        "type"
      ],
      "properties": {
        "type": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "size",
              "line",
              "weight",
              "family"
            ],
            "properties": {
              "size": {
                "$ref": "#/$defs/px"
              },
              "line": {
                "$ref": "#/$defs/px"
              },
              "family": {
                "enum": [
                  "sans",
                  "mono"
                ]
              }
            }
          }
        }
      }
    },
    "space": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/px"
      }
    },
    "radius": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/px"
      }
    },
    "border": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/px"
      }
    },
    "elevation": {
      "type": "object",
      "required": [
        "light",
        "dark"
      ]
    },
    "control": {
      "type": "object",
      "required": [
        "sm",
        "md",
        "lg"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/px"
      }
    },
    "motion": {
      "type": "object",
      "required": [
        "duration",
        "easing"
      ]
    },
    "breakpoint": {
      "type": "object",
      "required": [
        "rail",
        "sidebar"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/px"
      }
    },
    "touchTarget": {
      "type": "object",
      "required": [
        "web",
        "android",
        "ios"
      ]
    }
  },
  "$defs": {
    "hex": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "px": {
      "type": "string",
      "pattern": "^[0-9]+px$"
    },
    "palette": {
      "type": "object",
      "required": [
        "bg",
        "surface",
        "surface-2",
        "border",
        "border-strong",
        "fg",
        "fg-2",
        "fg-3",
        "send",
        "send-hover",
        "send-soft",
        "send-ink",
        "on-send",
        "receive",
        "receive-soft",
        "receive-ink",
        "on-receive",
        "success",
        "info",
        "warning",
        "warning-soft",
        "warning-ink",
        "danger",
        "danger-soft",
        "danger-ink",
        "cloud-soft",
        "cloud-ink",
        "focus",
        "toast",
        "toast-fg",
        "track",
        "scrim"
      ],
      "additionalProperties": {
        "type": "string",
        "pattern": "^(#[0-9A-Fa-f]{6}|rgba\\([0-9 ,.]+\\))$"
      }
    }
  }
}
